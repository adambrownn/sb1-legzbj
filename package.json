    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/node-fetch": "^2.6.12",
    "@types/stripe": "^8.0.416",
    "@vitejs/plugin-react": "^4.3.4",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.7.9",
    "chai": "^5.1.2",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "ioredis": "^5.4.1",
    "jest": "^29.7.0",
    "mocha": "^11.0.1",
    "nanoid": "^5.0.9",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.7",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.31",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^4.4.9"
  }
}
