{
  "name": "sb1-property-booking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "cross-env NODE_ENV=development nodemon --watch src --watch server.ts -e ts --exec \"tsx\" server.ts",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage",
    "test:unified": "tsx --no-warnings src/test/run-unified-tests.ts",
    "test:components": "tsx --no-warnings src/test/run-component-tests.ts",
    "test:calendar-sync": "tsx --no-warnings src/test/validate-calendar-sync.ts",
    "test:availability": "tsx --no-warnings src/test/validate-availability.ts",
    "test:payment": "mocha --require ts-node/register --loader ts-node/esm --no-warnings src/test/validate-payment.ts",
    "test:booking": "tsx --no-warnings src/test/validate-booking-modifications.ts",
    "test:load": "tsx --no-warnings src/test/load-test.ts",
    "start:server1": "cross-env PORT=3001 NODE_ENV=production tsx server.ts",
    "start:server2": "cross-env PORT=3002 NODE_ENV=production tsx server.ts",
    "start:server3": "cross-env PORT=3003 NODE_ENV=production tsx server.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@sentry/react": "^8.42.0",
    "@tanstack/react-query": "^5.62.3",
    "@types/classnames": "^2.3.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/csurf": "^1.11.5",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react-datepicker": "^6.2.0",
    "@types/redis": "^4.0.10",
    "@types/socket.io-client": "^1.4.36",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.0.0",
    "concurrently": "^7.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.10.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "nodemailer": "^7.0.7",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-datepicker": "^7.5.0",
    "react-day-picker": "latest",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.5",
    "react-facebook-login": "^4.1.1",
    "react-google-login": "^5.2.2",
    "react-hook-form": "latest",
    "react-icons": "latest",
    "react-joyride": "latest",
    "react-leaflet": "^4.2.1",
    "react-medium-image-zoom": "latest",
    "react-player": "latest",
    "react-router-dom": "^6.16.0",
    "recharts": "latest",
    "redis": "^4.7.0",
    "sentiment": "^5.0.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.4.0",
    "zod": "latest",
    "zustand": "latest"
